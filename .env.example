# ---------------------------------------------------------------
# pepsino LAB - environment template.
# Copy to .env (or your systemd EnvironmentFile) and fill in values.
# NEVER commit real values. Keep the file readable only by the service user:
#   chmod 600 .env
# ---------------------------------------------------------------

NODE_ENV=production
PORT=3000
# Keep the app bound to loopback; Nginx/Caddy terminates TLS on the public side.
HOST=127.0.0.1
# Exact public origin of the site (https in production). Used for CSRF checks.
PUBLIC_ORIGIN=https://pepsinogen.net
# Number of reverse-proxy hops in front of the app (1 for Nginx on the same host).
TRUST_PROXY=1

# SQLite database file. Must live OUTSIDE any public web directory.
DB_PATH=/var/lib/pepsino-lab/pepsino.sqlite
# Private uploads (answer sheets, answer keys). Must be outside the web root.
DATA_DIR=/var/lib/pepsino-lab/data
BACKUP_DIR=/var/backups/pepsino-lab
BACKUP_RETENTION_DAYS=14

# Sessions
SESSION_TTL_HOURS=8
SESSION_ABSOLUTE_HOURS=24
BCRYPT_ROUNDS=12
# Days after results are published during which a student may file an appeal.
APPEAL_WINDOW_DAYS=7

# Administrator (single account). The password is NOT stored here:
# set it with `npm run set-admin-password` (hidden prompt).
ADMIN_USERNAME=admin

# Telegram bot (optional; without a token, notifications stay queued).
# Create the bot with @BotFather and paste the token. Never commit it.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to press Accept/Reject.
# Individual identities must be listed explicitly.
TELEGRAM_ADMIN_IDS=
# Chat ID where registration requests are sent (a private chat or group).
TELEGRAM_ADMIN_CHAT_ID=
# Random string (>=32 chars) sent by Telegram in the webhook secret header.
TELEGRAM_WEBHOOK_SECRET=
# Random key (>=32 chars) for signing Accept/Reject button payloads.
TELEGRAM_CALLBACK_KEY=

# Outbox (notification retries)
OUTBOX_INTERVAL_MS=15000
OUTBOX_MAX_ATTEMPTS=8
